# ─────────────────────────────────────────────────────────────
# SUPABASE (já existente)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────────────────────────────────────────
# MERCADO PAGO
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# ─────────────────────────────────────────────────────────────

# Access Token da sua aplicação MP (começa com APP_USR- em produção ou TEST- em sandbox)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# URL base do seu site (sem barra no final)
NEXT_PUBLIC_BASE_URL=https://centenariosdosaflitos.vercel.app

# ─────────────────────────────────────────────────────────────
# COMO CONFIGURAR NO VERCEL:
#   1. Acesse vercel.com → seu projeto → Settings → Environment Variables
#   2. Adicione cada variável acima com o valor real
#   3. Faça um novo deploy após salvar
#
# COMO OBTER O ACCESS TOKEN DO MERCADO PAGO:
#   1. Acesse mercadopago.com.br/developers
#   2. Crie uma aplicação (tipo: Checkout Pro)
#   3. Copie o "Access Token de produção" (começa com APP_USR-)
#   4. Para testar primeiro: use o "Access Token de teste" (começa com TEST-)
#
# WEBHOOK:
#   Após o deploy, configure a URL do webhook no painel MP:
#   https://www.mercadopago.com.br/developers/panel/app → sua app → Webhooks
#   URL: https://centenariosdosaflitos.vercel.app/api/webhook/mercadopago
#   Evento: payment
# ─────────────────────────────────────────────────────────────
